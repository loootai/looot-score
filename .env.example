# Admin password for the web app. 12 characters or more. Required outside the demo.
# Without it the admin pages and API stay closed and /login shows a setup page.
LOOOT_SCORE_ADMIN_PASSWORD=
# Alternative to the plain password: the output of `npm run hash-password -- 'your password'`. Wins if both are set.
# LOOOT_SCORE_ADMIN_PASSWORD_HASH=
# Optional. Key that signs session cookies. Default: derived from the password, so a new password signs everyone out.
# LOOOT_SCORE_SESSION_SECRET=
# Optional. Set to 0 only to test over plain http in production mode. Leave unset otherwise.
# LOOOT_SCORE_COOKIE_SECURE=
# Optional. Spend cap per web run in dollars. Default 5. The browser cannot change it.
# LOOOT_SCORE_CAP_USD=

# looot key for real runs. Create one in looot Settings > Agent tokens. Not needed for the demo.
LOOOT_TOKEN=
# Optional. Overrides the API base, default https://api.looot.ai
LOOOT_API_URL=
# Optional. ICP file the web UI reads and writes, default config/icp.json
LOOOT_SCORE_ICP=
# Optional. Folder for the saved enrichment, default .looot-score
LOOOT_SCORE_DIR=
# Optional. Set to 1 to run the web UI on sample data
LOOOT_SCORE_DEMO=
