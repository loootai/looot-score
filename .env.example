# looot key for real runs. Create one in looot Settings > Agent tokens. Not needed for the demo.
LOOOT_TOKEN=
# Optional. Overrides the API base, default https://api.looot.ai
LOOOT_API_URL=
# Optional. ICP file the web UI reads and writes, default config/icp.json
LOOOT_SCORE_ICP=
# Optional. Folder for the saved enrichment, default .looot-score
LOOOT_SCORE_DIR=
# Optional. Set to 1 to run the web UI on sample data
LOOOT_SCORE_DEMO=
