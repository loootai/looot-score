#!/usr/bin/env bash
# Runs the leak scanner before every commit. Turn it on once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
# Sample leads use reserved .example domains.
export LEAK_SCAN_ALLOWED_EMAILS='@([a-z0-9-]+\.example|gmail\.com)$'
exec bash "$root/scripts/leak-scan.sh" "$root"
