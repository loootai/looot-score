{
  "name": "looot-score",
  "version": "0.1.3",
  "description": "Open-source lead and ICP fit scoring. A CSV of leads in, enriched through looot, graded A to D with reasons. Next.js and looot.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo": "node scripts/demoGuard.mjs && LOOOT_SCORE_DEMO=1 next dev -p 3272",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint .",
    "hash-password": "node scripts/hashPassword.mjs",
    "leak-scan": "LEAK_SCAN_ALLOWED_EMAILS='@([a-z0-9-]+\\.example|gmail\\.com)$' bash scripts/leak-scan.sh .",
    "score": "tsx src/cli/cli.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
